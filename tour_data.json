import os
import json
import re
import hashlib
import urllib.request
import xml.etree.ElementTree as ET

# ================= 1. 后台定时抓取巡演/开票公告的 RSS 源 =================
# priority 越小优先级越高（官博优先于个人微博）
RSS_FEEDS = [
    {"artist": "ONER", "priority": 1, "url": "https://rsshub.app/weibo/user/6524267181"},
    {"artist": "坤音娱乐", "priority": 1, "url": "https://rsshub.app/weibo/user/6062604272"},
    {"artist": "ONER", "priority": 2, "url": "https://rsshub.app/bilibili/user/video/670365731"},
    {"artist": "坤音娱乐", "priority": 2, "url": "https://rsshub.app/bilibili/user/video/172392717"},
    {"artist": "岳岳", "priority": 3, "url": "https://rsshub.app/weibo/user/6392771552"},
    {"artist": "木子洋", "priority": 3, "url": "https://rsshub.app/weibo/user/6400910760"},
    {"artist": "灵超", "priority": 3, "url": "https://rsshub.app/weibo/user/6400910962"},
]

KEYWORDS = ["巡演", "演唱会", "见面会", "音乐节", "开票", "预售", "一开", "二开", "三开", "加场", "大麦", "猫眼", "纷玩岛"]

DATA_FILE = "tour_data.json"
API_KEY = os.environ.get("LLM_API_KEY", "")
BASE_URL = os.environ.get("LLM_BASE_URL", "https://api.deepseek.com/chat/completions")
MODEL_NAME = os.environ.get("LLM_MODEL", "deepseek-flash")


def normalize_city(city_str):
    """统一城市名称格式，避免 '北京' 和 '北京站' 重复建卡"""
    c = (city_str or "").strip()
    c = re.sub(r"(站|专场|场)$", "", c)
    return f"{c}站" if c else ""


def get_text_fingerprint(text):
    """提取核心文案指纹，过滤掉转发前缀和话题标签，防止多人转发同一文案重复调用 AI"""
    cleaned = re.sub(r"//?@[^:：\s]+[:：]?", "", text)
    cleaned = re.sub(r"#[^#]+#", "", cleaned)
    cleaned = re.sub(r"[^\w\u4e00-\u9fa5]", "", cleaned)
    return hashlib.md5(cleaned[:200].encode("utf-8")).hexdigest()


def fetch_rss_items(url):
    items = []
    try:
        req = urllib.request.Request(url, headers={"User-Agent": "Mozilla/5.0"})
        with urllib.request.urlopen(req, timeout=20) as resp:
            xml_data = resp.read().decode("utf-8", errors="ignore")
        root = ET.fromstring(xml_data)
        for node in root.findall(".//item") + root.findall(".//{http://www.w3.org/2005/Atom}entry"):
            title = (node.findtext("title") or node.findtext("{http://www.w3.org/2005/Atom}title") or "").strip()
            desc = (node.findtext("description") or node.findtext("{http://www.w3.org/2005/Atom}content") or "").strip()
            link = (node.findtext("link") or "").strip()
            if not link:
                link_el = node.find("{http://www.w3.org/2005/Atom}link")
                if link_el is not None:
                    link = link_el.attrib.get("href", "")
            clean_text = re.sub(r"<[^>]+>", " ", f"{title} {desc}")
            clean_text = re.sub(r"\s+", " ", clean_text).strip()
            items.append({"text": clean_text[:1500], "link": link})
    except Exception as e:
        print(f"抓取 RSS 失败 ({url}): {e}")
    return items[:10]


def call_ai_extract(text, default_artist):
    if not API_KEY:
        print("未配置 LLM_API_KEY，跳过提取")
        return None

    prompt = f"""你是巡演信息结构化提取与去重助手。请分析以下动态文本，判断是否包含【演唱会/巡演/见面会/音乐节的演出时间或开票时间（一开/二开/三开/预售）】。
注意：如果成员个人账号转发宣传的是 ONER 团体演出，artist 必须统一填 "ONER"；只有明确是个人单人演出时才填个人名字。
如果与演出/开票无关，只返回 {{"is_tour": false}}。
如果有关，严格按以下 JSON 格式返回（时间统一为 YYYY-MM-DD HH:MM 格式，未知则留空字符串）：
{{
  "is_tour": true,
  "artist": "ONER / 木子洋 / 岳岳 / 灵超 / 坤音娱乐（团体演出统一填 ONER）",
  "city": "城市名，如：北京站",
  "venue": "场馆名称（未知留空）",
  "show_date": "演出时间，如：2026-12-20 19:30（未知留空）",
  "round_name": "开票轮次，如：一开 / 二开 / 三开 / 预售（无具体开票轮次留空）",
  "sale_time": "开票时间，如：2026-12-05 14:18（未知留空）",
  "platform": "购票平台，如：大麦 / 猫眼 / 纷玩岛（未知留空）"
}}

动态内容：
{text}"""

    payload = json.dumps({
        "model": MODEL_NAME,
        "messages": [{"role": "user", "content": prompt}],
        "response_format": {"type": "json_object"},
        "temperature": 0.1
    }).encode("utf-8")

    req = urllib.request.Request(
        BASE_URL,
        data=payload,
        headers={
            "Content-Type": "application/json",
            "Authorization": f"Bearer {API_KEY}"
        }
    )
    try:
        with urllib.request.urlopen(req, timeout=30) as resp:
            res = json.loads(resp.read().decode("utf-8"))
            content = res["choices"][0]["message"]["content"]
            return json.loads(content)
    except Exception as e:
        print(f"AI 提取异常: {e}")
        return None


def main():
    if os.path.exists(DATA_FILE):
        with open(DATA_FILE, "r", encoding="utf-8") as f:
            tour_list = json.load(f)
    else:
        tour_list = []

    processed_links = set()
    for item in tour_list:
        if item.get("source_url"):
            processed_links.add(item["source_url"])
        for url in item.get("related_urls", []):
            processed_links.add(url)

    seen_fingerprints = set()
    updated = False

    # 按优先级排序抓取（官博优先）
    sorted_feeds = sorted(RSS_FEEDS, key=lambda x: x["priority"])

    for feed in sorted_feeds:
        for item in fetch_rss_items(feed["url"]):
            if item["link"] in processed_links:
                continue
            if not any(kw in item["text"] for kw in KEYWORDS):
                continue

            fp = get_text_fingerprint(item["text"])
            if fp in seen_fingerprints:
                print(f"跳过高度雷同转发文案: {item['link']}")
                processed_links.add(item["link"])
                continue
            seen_fingerprints.add(fp)

            print(f"发现疑似巡演动态，调用 AI 提取: {item['link']}")
            extracted = call_ai_extract(item["text"], feed["artist"])
            if not (extracted and extracted.get("is_tour") and extracted.get("city")):
                continue

            artist_name = (extracted.get("artist") or feed["artist"]).strip()
            if artist_name == "坤音娱乐":
                artist_name = "ONER"
            city = normalize_city(extracted["city"])
            venue = (extracted.get("venue") or "").strip()
            show_date = (extracted.get("show_date") or "").strip()
            sale_time = (extracted.get("sale_time") or "").strip()
            round_name = (extracted.get("round_name") or "开票").strip()
            platform = (extracted.get("platform") or "官方渠道").strip()

            # 查找同一艺人 + 同一城市的现有记录（若日期不同且均已知，视为加场或不同巡演）
            existing = None
            for x in tour_list:
                if x.get("artist") == artist_name and normalize_city(x.get("city")) == city:
                    old_day = (x.get("show_date") or "")[:10]
                    new_day = show_date[:10]
                    if not old_day or old_day == "待公布" or not new_day or old_day == new_day:
                        existing = x
                        break

            if existing:
                # 增量补全缺失的关键信息，不覆盖已有的有效详情
                if venue and existing.get("venue") in ("", "待公布", None):
                    existing["venue"] = venue
                if show_date and existing.get("show_date") in ("", "待公布", None):
                    existing["show_date"] = show_date

                # 若当前来源优先级更高（如官博），更新主链接
                if feed["priority"] <= existing.get("_priority", 99):
                    existing["source_url"] = item["link"]
                    existing["_priority"] = feed["priority"]

                related = existing.setdefault("related_urls", [])
                if item["link"] not in related:
                    related.append(item["link"])

                # 合并去重开票轮次（一开/二开/三开）
                if sale_time:
                    is_dup_round = any(
                        r.get("sale_time") == sale_time or (r.get("round_name") == round_name and r.get("sale_time"))
                        for r in existing.get("rounds", [])
                    )
                    if not is_dup_round:
                        existing.setdefault("rounds", []).append({
                            "round_name": round_name,
                            "sale_time": sale_time,
                            "platform": platform
                        })
                        # 按开票时间先后自动排序
                        existing["rounds"].sort(key=lambda r: r.get("sale_time", ""))
            else:
                new_entry = {
                    "artist": artist_name,
                    "city": city,
                    "venue": venue or "待公布",
                    "show_date": show_date or "待公布",
                    "rounds": [{"round_name": round_name, "sale_time": sale_time, "platform": platform}] if sale_time else [],
                    "source_url": item["link"],
                    "related_urls": [item["link"]],
                    "_priority": feed["priority"]
                }
                tour_list.append(new_entry)

            processed_links.add(item["link"])
            updated = True

    if updated:
        with open(DATA_FILE, "w", encoding="utf-8") as f:
            json.dump(tour_list, f, ensure_ascii=False, indent=2)
        print("tour_data.json 已完成去重合并并更新！")
    else:
        print("本次巡检无新巡演信息。")


if __name__ == "__main__":
    main()
