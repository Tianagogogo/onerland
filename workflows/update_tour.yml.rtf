\f0\fs24 \cf0 name: Auto Extract Tour Schedule\
\
on:\
  schedule:\
    - cron: '*/15 * * * *' # \uc0\u27599  15 \u20998 \u38047 \u33258 \u21160 \u36816 \u34892 \u19968 \u27425 \
  workflow_dispatch:        # \uc0\u25903 \u25345 \u22312  GitHub \u32593 \u39029 \u19978 \u25163 \u21160 \u28857 \u25353 \u38062 \u31435 \u21051 \u36816 \u34892 \u27979 \u35797 \
\
permissions:\
  contents: write\
\
jobs:\
  extract-and-commit:\
    runs-on: ubuntu-latest\
    steps:\
      - name: Checkout repository\
        uses: actions/checkout@v4\
\
      - name: Set up Python\
        uses: actions/setup-python@v5\
        with:\
          python-version: '3.11'\
\
      - name: Run tour extraction script\
        env:\
          LLM_API_KEY: $\{\{ secrets.LLM_API_KEY \}\}\
        run: python scripts/fetch_and_extract.py\
\
      - name: Commit updated tour_data.json\
        run: |\
          git config user.name "github-actions[bot]"\
          git config user.email "github-actions[bot]@users.noreply.github.com"\
          git add tour_data.json\
          git diff --quiet && git diff --staged --quiet || (git commit -m "chore: \uc0\u33258 \u21160 \u26356 \u26032 \u24033 \u28436 \u24320 \u31080 \u20449 \u24687 " && git push)\
}